# Versiones fijadas de la capa de Add-ons (lab EDA)
ISTIO_VERSION="1.24.2"          # solo AKS: ingress gateway como borde del Event Mesh
CERT_MANAGER_VERSION="v1.16.2"  # solo AKS: TLS Let's Encrypt del borde
KEDA_VERSION="2.16.0"           # ambos: autoescalado 0..N del declaration-gateway
KEDA_HELM_CHART_VERSION="2.16.0"
REDPANDA_IMAGE="docker.redpanda.com/redpandadata/redpanda:v24.2.7"  # referencia (deploy/base/redpanda.yaml)
KNATIVE_VERSION="1.16.0"        # opcional (--knative): Knative Eventing core, ambos clusters
KNATIVE_KAFKA_VERSION="1.16.0"  # opcional (--knative): eventing-kafka-broker (KafkaSource onprem; Broker/Sink nube)
