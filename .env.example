# Copia a .env (no se versiona).
GATEWAY_PAYMENT_TOKEN=cambia-esto-pago
GATEWAY_ADMIN_TOKEN=cambia-esto-admin
MESH_TOKEN=demo-token
LLAVE_DOCUMENTOS_HEX=
# --- LLM (R4) --- ver retos/r4-agentes-ia/copiloto/llm.py
# Azure AI Foundry (o GitHub Models): proveedor openai + endpoint compatible con OpenAI.
LLM_PROVIDER=openai
# Nombre del DESPLIEGUE del modelo en Foundry (p. ej. gpt-4o-mini)
LLM_MODEL=
# https://<recurso>.openai.azure.com/openai/v1/   (o https://<recurso>.services.ai.azure.com/openai/v1/)
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Alternativas: LLM_PROVIDER=google_genai + GOOGLE_API_KEY · groq + GROQ_API_KEY · anthropic + ANTHROPIC_API_KEY
# Ritmo de peticiones por segundo (sube a 2 si tu cuota lo permite)
LLM_RPS=1
